+# Emite "<hostname_nodo_fisico> <ip_overlay>" por cada tarea Running de un servicio.
+# Usado por el modo distribuido, que necesita saber en QUE nodo fisico esta cada replica.
+xpn_docker_svc_node_ips ()
+{
+        SVC=$1
+        for T in $(docker service ps $SVC -f desired-state=running -q); do
+                NODE_ID=$(docker inspect -f '{{.NodeID}}' $T 2>/dev/null)
+                NODE_NAME=$(docker node inspect -f '{{.Description.Hostname}}' $NODE_ID 2>/dev/null)
+                IP=$(docker inspect -f '{{range .NetworksAttachments}}{{.Addresses}}{{end}}' $T 2>/dev/null \
+                       | sed "s/^\[//g" | awk 'BEGIN {FS="/"} ; {print $1}' | grep '^192\.168\.')
+                if [ -n "$NODE_NAME" ] && [ -n "$IP" ]; then
+                        echo "$NODE_NAME $IP"
+                fi
+        done
+}
