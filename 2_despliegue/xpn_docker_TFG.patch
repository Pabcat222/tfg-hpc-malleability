+xpn_docker_wait_running ()
+{
+        # Espera (hasta ~2 min) a que ambos servicios del stack 2svc tengan todas
+        # sus réplicas Running, para que las tareas ya tengan IP de overlay antes de
+        # generar machines_mpi. Si no convergen, avisa (probablemente error de mount
+        # o de red overlay: revisar 'docker service ps ... --no-trunc').
+        WR_APP=$1
+        WR_XPN=$2
+        echo "Waiting for tasks to reach Running (epigraph=$WR_APP, xpn=$WR_XPN)..."
+        for _i in $(seq 1 60); do
+            # Solo el "N/M": con max_replicas_per_node, docker anade el sufijo
+            # "(max K per node)" y la comparacion exacta fallaba (falsa alarma).
+            R_APP=$(docker service ls --filter name=${DOCKER_PREFIX_NAME}_epigraph --format '{{.Replicas}}' | awk '{print $1}')
+            R_XPN=$(docker service ls --filter name=${DOCKER_PREFIX_NAME}_xpn --format '{{.Replicas}}' | awk '{print $1}')
+            if [ "$R_APP" = "$WR_APP/$WR_APP" ] && [ "$R_XPN" = "$WR_XPN/$WR_XPN" ]; then
+                echo "All tasks Running (epigraph $R_APP, xpn $R_XPN)."
+                return 0
+            fi
+            sleep 2
+        done
+        echo ": WARNING: tasks did not reach Running in time (epigraph $R_APP, xpn $R_XPN)."
+        echo ":  * Check: docker service ps ${DOCKER_PREFIX_NAME}_epigraph ${DOCKER_PREFIX_NAME}_xpn --no-trunc"
+        return 1
+}
