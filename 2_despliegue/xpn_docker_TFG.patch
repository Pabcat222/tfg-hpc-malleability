+                xpn_docker_svc_node_ips ${DOCKER_PREFIX_NAME}_xpn \
+                  | awk '{ n[$1]++; ip[$1 SUBSEP n[$1]] = $2;
+                           if (!($1 in seen)) { seen[$1] = 1; order[++k] = $1 } }
+                         END { max = 0;
+                               for (h in n) if (n[h] > max) max = n[h];
+                               for (i = 1; i <= max; i++)
+                                 for (j = 1; j <= k; j++) {
+                                   h = order[j];
+                                   if (i <= n[h]) print ip[h SUBSEP i]
+                                 } }' >> machines_mpi
+        fi
 
         # machines_mpi -> machines_hosts + etc_hosts
         echo -n "" > machines_hosts
