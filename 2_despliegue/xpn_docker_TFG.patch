+                # Escenario 2 servicios: EpiGraph (app) primero, XPN al final, de modo que
+                # lanza_xpn_estatico.sh (head -n N_APP = app, tail -n N_XPN = xpn) asigne bien.
+                # Se filtra a la red overlay backend (192.168.*) para descartar ingress/gwbridge.
+                : > machines_mpi
+                for SVC in ${DOCKER_PREFIX_NAME}_epigraph ${DOCKER_PREFIX_NAME}_xpn; do
+                        for T in $(docker service ps $SVC -f desired-state=running -q); do
+                                docker inspect -f '{{range .NetworksAttachments}}{{.Addresses}}{{end}}' $T \
+                                  | sed "s/^\[//g" | awk 'BEGIN {FS="/"} ; {print $1}' \
+                                  | grep '^192\.168\.'
+                        done >> machines_mpi
+                done
+        fi
+        if [ "$MODE" == "MULTI_NODE_2SVC_DIST" ]; then
+                # Escenario DISTRIBUIDO: ambos servicios repartidos entre los dos nodos.
+                # Igual que 2SVC, app primero y XPN al final (head -n N_APP / tail -n N_XPN),
+                # pero el bloque XPN se INTERCALA por nodo fisico (n1,n3,n1,n3,...) para que
+                # cualquier `tail -n N_XPN` par tome N/2 servidores de CADA nodo. Sin intercalar,
+                # `docker service ps` puede devolver juntos los de un mismo nodo y un barrido
+                # de 2 servidores caeria entero en uno solo, dejando a la mitad de los clientes
+                # sin servidor local -- justo el efecto que el experimento quiere medir.
+                : > machines_mpi
+
+                # app: el orden es indiferente (siempre se toma entero con head -n N_APP)
+                xpn_docker_svc_node_ips ${DOCKER_PREFIX_NAME}_epigraph \
