+	/* Centinela para la maleabilidad por spawn: MPI_Comm_spawn serializa el argv
+	 * por PMI-1, que NO admite un argumento vacio (-> "Expecting value after arg2=
+	 * / unable to parse PMI command"). El lanzador pasa "@" como prefijo de rutas
+	 * (argv[2]). CLAVE: NO mutamos argv[2] aqui — FlexMPI reusa el mismo argv del
+	 * proceso para el MPI_Comm_spawn (process.c: EMPI_Spawn_process), asi que si lo
+	 * vaciasemos, el spawn volveria a serializar un arg vacio y PMI fallaria igual.
+	 * En su lugar mapeamos "@"->"" en un puntero LOCAL (cPathPrefix) que se usa para
+	 * construir las rutas, dejando argv[2]="@" intacto para que el spawn lo serialice
+	 * (no vacio -> PMI OK). Los hijos spawneados reciben argv[2]="@" y repiten este
+	 * mismo mapeo tras su MPI_Init. Ver install-src/lanza_multinodo_spawn.sh. */
+	if (argc >= 3)
+		cPathPrefix = (strcmp (argv[2], "@") == 0) ? "" : argv[2];
